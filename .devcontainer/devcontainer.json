{
  "name": "ATLAS Telemetry Lab",

  // A plain container with Docker inside it, rather than a compose-orchestrated
  // devcontainer.
  //
  // Two reasons. First, the lab *teaches* `docker compose up` — Module 1 opens
  // with it — so having the stack silently already running would remove the
  // first thing a learner is meant to do. Second, a compose-based devcontainer
  // has to pin `workspaceFolder` to a path containing the repository name, and
  // the repository name is whatever the learner chooses when they use the
  // template. That mismatch breaks the container for everyone who does not
  // happen to pick the name we guessed.
  // Built from a Dockerfile rather than used directly, only so we can strip a
  // broken apt source out of the upstream image before Features install on top
  // of it. The Dockerfile explains why at length — it cost us a silent recovery
  // container to find.
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // Not for the learner — they use the browser or VS Code, neither of which
    // needs this. It is so that `gh codespace ssh` works at all, which is the
    // only way to inspect a Codespace that has gone wrong from outside it.
    // Without it both `gh codespace ssh` and `gh codespace logs` fail, and the
    // container you most need to look at is the one you cannot get into.
    "ghcr.io/devcontainers/features/sshd:1": {},
    // `gh` is NOT in the Python image — it is baked into GitHub's universal
    // image, which is not what we build from. Without it `lab submit` cannot
    // open the pull request, which is half the point of the command.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // A minimum, not a choice — GitHub offers every machine type that meets it,
  // smallest first. This was `cpus: 4`, which meant the 2-core machine was
  // never offered and every learner burned free-tier hours at twice the rate
  // (120 core-hours is 60 hours at 2 cores, 30 at 4). The stack idles at
  // ~442 MiB, so 2 cores is genuinely enough; anyone who wants 4 can still pick
  // it from the machine-type list.
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },

  "forwardPorts": [8080, 9092, 13579, 15379],
  "portsAttributes": {
    "8080": { "label": "Kafka UI", "onAutoForward": "notify" },
    "9092": { "label": "Kafka broker", "onAutoForward": "silent" },
    "13579": { "label": "ATLAS Stream API", "onAutoForward": "silent" },
    "15379": { "label": "Key Generator", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    // Open the instructions, rendered, the moment the Codespace appears.
    //
    // Without this a learner lands in an empty editor looking at a file tree.
    // `openFiles` only works in the VS Code *web* client and only on the first
    // open — which is precisely the moment that matters — and the editor
    // association is what makes README.md arrive as a rendered page rather than
    // as raw Markdown source. Reopen as text with "View: Reopen Editor With".
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-containers"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" },
        "workbench.startupEditor": "readme",
        "files.exclude": { "**/__pycache__": true, "**/.lab/.consumed": true }
      }
    }
  },

  "remoteUser": "vscode"
}
